# Copy file này thành `.env` rồi điền giá trị (file `.env` đã được gitignore).
# Đổi giá trị xong thì khởi động lại Metro kèm --reset-cache.
# Lưu ý: tên key KHÔNG có tiền tố VITE_ (đó là của web).

# URL backend Langoo API (không có dấu / ở cuối)
API_BASE_URL=

# Web OAuth client ID cho "Đăng nhập bằng Google" (chưa dùng — để trống được).
GOOGLE_WEB_CLIENT_ID=
