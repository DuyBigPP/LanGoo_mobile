{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "index.js", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "android", "ios", "**/*.test.ts", "**/*.test.tsx"]
}
